{
  "name": "lanball",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lanball/client",
    "server": "node packages/server/src/index.ts",
    "build": "npm run build -w @lanball/client",
    "host": "npm run build && npm run server",
    "start": "npm run host",
    "test": "vitest run",
    "typecheck": "tsc -p packages/sim && tsc -p packages/server && tsc -p packages/client"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
